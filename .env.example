# Nombre que identificará el conjunto de contenedores.
APP_COMPOSE_PROJECT_NAME=analizador-de-facturas

# Imágenes oficiales de la aplicación. "latest" instala la versión más reciente.
# También puede usarse una versión (por ejemplo, 1.0.0) o el SHA de un commit.
IMAGE_NAMESPACE=rogervega33
IMAGE_TAG=latest

# Usa una contraseña segura compuesta por letras y números. No cambies estos
# valores después de crear la base de datos sin actualizar también PostgreSQL.
POSTGRES_DB=analizador_de_facturas
POSTGRES_USER=analizador_de_facturas
POSTGRES_PASSWORD=cambiar_por_una_clave_larga_y_aleatoria
POSTGRES_VOLUME=analizador-de-facturas_datos_postgres

# 0.0.0.0 permite el acceso desde otros equipos de la red.
# Usa 127.0.0.1 si solamente accederás desde este equipo o mediante un proxy local.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080

# Usa true cuando la dirección pública utilice HTTPS. Para HTTP usa false.
AUTH_COOKIE_SECURE=false
